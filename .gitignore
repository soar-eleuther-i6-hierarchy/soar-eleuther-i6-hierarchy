# Secrets — never commit
.env
*.pem
id_ed25519*
id_rsa*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# NOTE: docker/requirements-metrics.txt is generated by `uv pip compile` but MUST
