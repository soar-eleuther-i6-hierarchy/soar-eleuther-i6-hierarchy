# Secrets — never commit
.env
*.pem
id_ed25519*
id_rsa*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# NOTE: docker/requirements-metrics.txt is generated by `uv pip compile` but MUST
# be committed — the metrics image builds from it, and docker/README.md explains
# why an unpinned build is worse than no build. Do not add it here.

# Local run artifacts
outputs_local/
scratch/
*.log
scripts/hf_sync/upload_manifest.tsv
scripts/hf_sync/upload_status.tsv
scripts/hf_sync/upload_log.txt

# Heavy caches — hosted on the Hub, never in git
*.pt
*.bin
*.safetensors

# OS
.DS_Store

# Data pulled from the compute node for local testing (read-only copies)
data/

# Kept local, never committed. A directory rather than a list of filenames, so a new
# local-only note does not have to remember to add itself here.
#   SERVER.md     the GPU node: address, paths, environment
#   DECISIONS.md  internal reasoning about the team's own choices
research-log/local/

# Local-only tooling, never committed. A directory rather than a filename, so a
# rename inside it does not silently un-ignore the file.
scripts/local/
findings/
dist/
